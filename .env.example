# Copy file này thành .env và điền giá trị thật — KHÔNG commit .env vào git

# --- Postgres ---
POSTGRES_USER=jobmarket
POSTGRES_PASSWORD=changeme
POSTGRES_DB=jobmarket
POSTGRES_PORT=5432

# --- Crawler ---
CRAWL_BASE_URL=https://example.com/jobs
CRAWL_SLEEP_SECONDS=1

# --- Airflow (điền ở Tuần 2) ---
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://jobmarket:changeme@postgres/jobmarket
AIRFLOW__CORE__FERNET_KEY=

# --- Grafana (điền ở Tuần 4) ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme
